<?xml version="1.0" encoding="UTF-8"?>
<!--
  VeloEdit — WiX v4 package script (SPEC §6.1)

  Produces: the versioned x64 Setup.msi

  Per-user package (Scope="perUser"): installs to
  %LOCALAPPDATA%\Programs\VeloEdit, needs no administrator rights, and
  registers under HKCU. Upgrades are MajorUpgrade: a newer version replaces
  the older one in one step.

  GUIDS — NEVER CHANGE THE UPGRADECODE. It is the identity every future
  VeloEdit MSI uses to recognise and upgrade earlier installs.
    UpgradeCode:  A38C6BC4-F086-4855-A7E6-8706BCA8F987
  The ProductCode is auto-generated by WiX on every build (the WiX v4
  default), which is what MajorUpgrade expects: each release is a new
  product that upgrades the previous one under the same UpgradeCode.

  This file is built ONLY on a Windows machine (the release workflow does
  it; WiX cannot build an MSI on Linux). Exact build commands (run from
  the repo root, after a cargo release build for the MSVC target):

    dotnet tool install (global) wix, version 4.0.6
    wix extension add WixToolset.UI.wixext/4.0.6
    (the extension version must match the tool's major version,
    or the build fails with WIX0144)
    wix build installer\Package.wxs -ext WixToolset.UI.wixext
        -o VeloEdit-v<VERSION>-x64-Setup.msi

  File sources are written with the sys.SOURCEFILEDIR preprocessor
  variable (the folder this file lives in), because WiX resolves plain
  relative sources against the build's working folder, not this file:
  an earlier revision used plain relative paths and the CI build could
  not find the payload (WIX0103).

  The payload exe must be staged in the data-adjacent layout: the package
  creates an empty data\ folder next to the program for portable settings.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="VeloEdit"
           Manufacturer="Sean Shaffer"
           Version="1.1.0"
           Scope="perUser"
           UpgradeCode="A38C6BC4-F086-4855-A7E6-8706BCA8F987">
    <MajorUpgrade DowngradeErrorMessage="A newer version of VeloEdit is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The program icon: used for the Add/Remove Programs entry (via
         ARPPRODUCTICON) and the Start Menu shortcut. The .ico sits next
         to this file (a copy of assets/veloedit.ico). -->
    <Icon Id="VeloEditIcon" SourceFile="$(sys.SOURCEFILEDIR)veloedit.ico" />
    <Property Id="ARPPRODUCTICON" Value="VeloEditIcon" />

    <!-- The one UI reference: minimal wizard from the UI extension. -->
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="VeloEdit">
          <Directory Id="DataFolder" Name="data" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="VeloEdit" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="VeloEditExe"
              Source="$(sys.SOURCEFILEDIR)..\target\x86_64-pc-windows-msvc\release\VeloEdit.exe"
              KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile" Guid="*">
        <File Id="LicenseTxt"
              Source="$(sys.SOURCEFILEDIR)..\LICENSE"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Empty data folder: a component with CreateFolder so the installer
         creates (and on uninstall removes) the folder itself; its contents
         are the user's and are left alone. This component carries an
         EXPLICIT guid (never change it): a folder-only component's key
         path is its directory, and WiX rejects auto-generated guids for
         those (WIX0230). -->
    <Component Id="DataFolderComponent" Directory="DataFolder" Guid="AE66BEE6-02EC-41BF-8B6D-B783DEA4F0ED">
      <CreateFolder />
      <RemoveFolder Id="RemoveDataFolder" On="uninstall" />
    </Component>

    <Component Id="ApplicationShortcut" Directory="AppShortcutFolder" Guid="*">
      <Shortcut Id="StartMenuShortcut"
                Name="VeloEdit"
                Description="Binary and large-file editor"
                Target="[INSTALLFOLDER]VeloEdit.exe"
                Icon="VeloEditIcon"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\VeloEdit"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="VeloEdit" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="DataFolderComponent" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
</Wix>
